  <diagram id="nexus-tier" name="Nexus 账号能力">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="Nexus 账号三档能力降级 —— 差异只存在于「下载」环节" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="用户点击「更新」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="80" width="420" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;无账号 · Anonymous&lt;/b&gt;&lt;br&gt;&lt;br&gt;· 扫描本地模组&lt;br&gt;· 检测更新（smapi.io）&lt;br&gt;· 判断 SMAPI / 游戏兼容性&lt;br&gt;· 依赖缺失检测&lt;br&gt;· 创建 / 切换 / 备份&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;· 自动下载 ✗&lt;br&gt;· 手动下载后拖入安装 ✓&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;免费账号 · Free&lt;/b&gt;&lt;br&gt;&lt;br&gt;· 包含无账号全部能力&lt;br&gt;· 注册 nxm:// 协议处理器&lt;br&gt;· OAuth2 登录与令牌刷新&lt;br&gt;· 网页点一次 → 客户端接管&lt;br&gt;· 自动下载 / 校验 / 解压 / 安装&lt;br&gt;· 安装前自动快照&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;· 批量全自动队列 ✗&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fontSize=12;fontColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Premium 会员&lt;/b&gt;&lt;br&gt;&lt;br&gt;· 包含免费账号全部能力&lt;br&gt;· API 直链下载&lt;br&gt;· 批量更新队列全自动&lt;br&gt;· 无浏览器跳转&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2d7d46&quot;&gt;· 一次点击完成全部更新 ✓&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fontSize=12;fontColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="180" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;strokeColor=#999999;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="entry" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="entry" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="entry" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="降级原则：不使用「假装全自动」的设计。UI 必须显式标注当前账号等级与缺失能力，并给出可执行的替代路径（跳转网页 / 手动导入），避免出现点击无响应的按钮。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="100" y="530" width="1200" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
